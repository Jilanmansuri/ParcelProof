# ParcelProof Frontend � Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# The base URL of your ParcelProof backend API.
# For local development on a real device/emulator over WiFi, use your machine's local IP:
#   EXPO_PUBLIC_API_URL=http://192.168.x.x:5000/api
# For production, use your deployed server URL:
#   EXPO_PUBLIC_API_URL=https://your-api-server.com/api
EXPO_PUBLIC_API_URL=http://xxxx.app.com/api
